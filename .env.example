# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_DB=pipeline_dados
CLICKHOUSE_USER=pipeline_user
CLICKHOUSE_PASSWORD=troque_esta_senha
CLICKHOUSE_PORT=8123

# Airflow / Postgres (Metadados)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
AIRFLOW_UID=50000
AIRFLOW_ADMIN_PASSWORD=troque_esta_senha
AIRFLOW_FERNET_KEY=gere_uma_chave_fernet_de_32_bytes
AIRFLOW_CONN_CLICKHOUSE_DEFAULT=http://pipeline_user:troque_esta_senha@clickhouse:8123/pipeline_dados

# Enriquecimento via LLM
LLM_PROVIDER=anthropic
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=sua_chave_anthropic_aqui
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
OPENAI_API_KEY=sua_chave_openai_aqui
OPENAI_MODEL=gpt-4o-mini
